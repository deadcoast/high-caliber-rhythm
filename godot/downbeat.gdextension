[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libdownbeat_core.so"
linux.release.x86_64 = "res://bin/libdownbeat_core.so"
windows.debug.x86_64 = "res://bin/downbeat_core.dll"
windows.release.x86_64 = "res://bin/downbeat_core.dll"
macos.debug = "res://bin/libdownbeat_core.dylib"
macos.release = "res://bin/libdownbeat_core.dylib"
